# =========================================================
# Multi-Agent Software Development Copilot - 环境配置示例
# 复制为 .env 后按需修改
# =========================================================

# ---------- 数据目录 ----------
# DATA_DIR=./data
# DATABASE_URL=sqlite+aiosqlite:///./data/copilot.db
# PostgreSQL 示例（需安装 extras: pip install -e ".[postgres]"）
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/copilot

# ---------- LLM ----------
# provider: openai | anthropic | mock
# openai 提供商兼容 OpenAI / DeepSeek / Ollama / vLLM / Gemini(OpenAI 兼容端点) 等
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
# 自建/代理端点示例：LLM_BASE_URL=http://127.0.0.1:11434/v1
# DeepSeek 示例：LLM_MODEL=deepseek-flash + LLM_BASE_URL=https://api.deepseek.com
LLM_BASE_URL=
LLM_TEMPERATURE=0.2
LLM_TIMEOUT=120
# 按 Agent 覆盖模型（JSON），键: supervisor/product/architect/coder/tester/reviewer
# LLM_MODEL_OVERRIDES={"coder": "gpt-4o"}
# 每 100 万 Token 价格（JSON，单位 USD），用于成本统计
# MODEL_PRICES={"gpt-4o-mini": {"input": 0.15, "output": 0.6}, "gpt-4o": {"input": 2.5, "output": 10.0}}
# Mock provider 离线演示/联调：JSON 脚本文件路径（{agent: [响应项]}），每次运行自动刷新
# 示例：LLM_PROVIDER=mock + MOCK_SCRIPTS_FILE=examples/demo_scripts.json
# MOCK_SCRIPTS_FILE=

# ---------- Agent 执行循环停止条件 ----------
AGENT_MAX_STEPS=50
AGENT_MAX_TOKENS=200000
AGENT_MAX_COST_USD=5.0
AGENT_TIMEOUT_SECONDS=1800
AGENT_MAX_TOOL_FAILURES=6

# ---------- 闭环重试上限 ----------
MAX_CODE_RETRY=3
MAX_TEST_RETRY=3
MAX_REVIEW_RETRY=3
MAX_PLAN_RETRY=2
# fixed: MVP 固定顺序调度; dynamic: 基于 Shared State 动态路由（V2）
SUPERVISOR_MODE=fixed

# ---------- Sandbox ----------
# docker: 所有代码执行在 Docker 沙箱内（默认，符合安全要求）
# local:  仅开发调试用，直接在本机子进程执行（不安全）
SANDBOX_MODE=docker
# 推荐先执行 ma-dev sandbox-build 构建带测试工具的镜像
SANDBOX_IMAGE=multi-agent-sandbox:py312
# 备用基础镜像: python:3.12-slim
SANDBOX_CPU_LIMIT=2.0
SANDBOX_MEMORY_LIMIT=2g
# none: 禁用容器网络; bridge: 允许访问网络（安装依赖时需要）
SANDBOX_NETWORK=none
SANDBOX_TIMEOUT_SECONDS=300
# 进入容器后、执行命令前运行的准备命令（如离线镜像无需设置）
SANDBOX_SETUP_COMMAND=

# ---------- 目标项目命令 ----------
TEST_COMMAND=python -m pytest -q
LINT_COMMAND=
BUILD_COMMAND=

# ---------- 人工审批 ----------
# 强制人工审批的工具（高风险）
FORCED_APPROVAL_TOOLS=["git_push", "deploy", "database_migration", "merge"]
# 可配置审批的工具（默认不开启，设为 true 后这些工具需人工审批）
REQUIRE_APPROVAL_FOR_EDIT=false
REQUIRE_APPROVAL_FOR_DELETE=false
REQUIRE_APPROVAL_FOR_COMMIT=false

# ---------- 服务 ----------
HOST=127.0.0.1
PORT=8000
